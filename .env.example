# ---------- REQUIRED ----------
# Password for the admin dashboard (/admin). Use a long, unique password.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign the admin login cookie (any 32+ random characters).
SESSION_SECRET=paste-a-long-random-string-here

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "service_role" secret key (NOT the anon key). Server-side only – never share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio → Get API key
GEMINI_API_KEY=your-gemini-api-key

# ---------- OPTIONAL ----------
# Leave empty: QR codes automatically use the address the dashboard is opened on
# (e.g. https://smart-review-agent.onrender.com). Only set this if you move to another address.
# NEXT_PUBLIC_SITE_URL=

# ---------- OPTIONAL ----------
# Gemini model to use (default: gemini-3.6-flash). Cheaper/faster: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.6-flash
