# ---------- REQUIRED ----------
# Password for the admin dashboard (/admin). Use a long, unique password.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign the admin and business-owner login cookies (any 32+ random characters).
# Required in production: business-owner login is disabled without it.
SESSION_SECRET=paste-a-long-random-string-here

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "service_role" secret key (NOT the anon key). Server-side only – never share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio → Get API key
GEMINI_API_KEY=your-gemini-api-key

# ---------- REQUIRED FOR QR CODES & REVIEW LINKS ----------
# Your LIVE website address, no trailing slash. Every QR code, review link, WhatsApp/SMS request and
# password-reset link uses this, even when you run the admin dashboard on localhost.
# Must be https and public (localhost / 192.168.x.x are refused).
PUBLIC_SITE_URL=https://smart-review-agent.onrender.com
NEXT_PUBLIC_SITE_URL=https://smart-review-agent.onrender.com
# To manage the LIVE site from your computer, also put the SAME Supabase keys Render uses (below)
# into .env.local, so local and live share one database.

# ---------- OPTIONAL ----------
# Public sign-up at /signup (default: on). Set to false so only the admin can create accounts.
# SIGNUP_ENABLED=true
# New sign-ups wait as "Pending" until the admin approves them (default). Set to false for instant access.
# SIGNUP_REQUIRES_APPROVAL=true

# Email for "Forgot password" links (https://resend.com). Without these, owners ask the admin,
# who can create a reset link from the admin panel.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Smart Review <no-reply@yourdomain.com>

# Gemini model to use (default: gemini-3.6-flash). On the FREE tier, Flash models currently allow only about
# 20 requests/day; Flash-Lite models about 500/day, so gemini-3.5-flash-lite serves far more customers for free.
# When the quota is used up, the app automatically uses its free built-in writer.
# GEMINI_MODEL=gemini-3.6-flash
